# Closed Alpha, local development. Copy to apps/web/.env.local (ignored by Git) and fill in.
#   Windows PowerShell: Copy-Item apps/web/.env.local.example apps/web/.env.local
#   macOS/Linux/Git Bash: cp apps/web/.env.local.example apps/web/.env.local
# Nothing here is a secret. Real values live only in your .env.local or in the hosting service.
# Check it with:  npm run alpha:env:check

# PostgreSQL used by the app at runtime. This matches the Docker service from `npm run db:up`
# (throwaway local credentials). Never point local development at the production database.
DATABASE_URL=postgresql://aoh:aoh@127.0.0.1:5432/aoh?schema=public

# Optional: direct connection used only for migrations. Leave commented locally; needed with a pooled hosted database.
# DIRECT_URL=postgresql://aoh:aoh@127.0.0.1:5432/aoh?schema=public

# ONLY when DATABASE_URL is a REMOTE database that is your DEVELOPMENT one (for example the Railway "development" environment).
# The scripts never guess production from a hostname, so a remote database is refused unless this line is here AND the command
# has --allow-remote:  npm run dev:alpha -- --allow-remote   /   npm run db:migrate:local -- --allow-remote
# Leave it out for a local database. Never set it for production.
# AOH_LOCAL_DB_ENV=development

# Signs guest sessions. Required, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ALPHA_SESSION_SECRET=

# Must be exactly this locally: the server checks the Origin of every request, and the app is served here.
# Open http://127.0.0.1:3001/alpha (not localhost).
ALPHA_PUBLIC_ORIGIN=http://127.0.0.1:3001

# Optional feedback link shown in the game (read at build/start time).
# NEXT_PUBLIC_ALPHA_FEEDBACK_URL=
