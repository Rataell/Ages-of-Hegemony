{
  "name": "ages-of-hegemony",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "npm run compile && npm run dev -w @aoh/web",
    "dev:alpha": "node scripts/local-alpha.mjs dev",
    "alpha:env:check": "node scripts/local-alpha.mjs check",
    "db:migrate:local": "node scripts/local-alpha.mjs migrate",
    "dev:server": "npm run compile && node apps/server/dist/main.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:up": "docker compose up -d --wait db-dev",
    "db:down": "docker compose stop db-dev",
    "db:test:up": "docker compose --profile test up -d --wait db-test",
    "db:test:down": "docker compose --profile test rm -sfv db-test",
    "compile": "npm run db:generate && tsc -b",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run compile && tsc -p tests/tsconfig.json && tsc -p e2e/tsconfig.json && npm run typecheck -w @aoh/web",
    "test": "npm run compile && vitest run",
    "test:e2e": "playwright test",
    "test:db": "npm run compile && vitest run --config vitest.db.config.ts",
    "test:db:docker": "npm run compile && node scripts/test-db.mjs",
    "build": "npm run compile && npm run build -w @aoh/web",
    "demo": "npm run compile && node apps/server/dist/demo.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "prisma": "^7.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
