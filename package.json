{
  "name": "ages-of-hegemony",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "node scripts/project-task.mjs dev:web",
    "dev:alpha": "node scripts/local-alpha.mjs dev",
    "dev:alpha:pg": "node scripts/local-alpha.mjs dev --postgres",
    "alpha:players": "node scripts/alpha-players.mjs",
    "alpha:lab": "node scripts/alpha-lab.mjs",
    "alpha:env:check": "node scripts/local-alpha.mjs check",
    "db:migrate:local": "node scripts/local-alpha.mjs migrate",
    "dev:server": "node scripts/project-task.mjs dev:server",
    "db:generate": "node scripts/project-task.mjs db:generate",
    "db:validate": "node scripts/project-task.mjs db:validate",
    "db:migrate": "node scripts/project-task.mjs db:migrate",
    "db:deploy": "node scripts/project-task.mjs db:deploy",
    "db:up": "docker compose up -d --wait db-dev",
    "db:down": "docker compose stop db-dev",
    "db:test:up": "docker compose --profile test up -d --wait db-test",
    "db:test:down": "docker compose --profile test rm -sfv db-test",
    "compile": "node scripts/project-task.mjs compile",
    "lint": "node scripts/project-task.mjs lint",
    "typecheck": "node scripts/project-task.mjs typecheck",
    "test": "node scripts/project-task.mjs test",
    "test:e2e": "node scripts/project-task.mjs test:e2e",
    "test:db": "node scripts/project-task.mjs test:db",
    "test:db:docker": "node scripts/project-task.mjs test:db:docker",
    "build": "node scripts/project-task.mjs build",
    "demo": "node scripts/project-task.mjs demo",
    "check": "node scripts/project-task.mjs check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "prisma": "^7.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
