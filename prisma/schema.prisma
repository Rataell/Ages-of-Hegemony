generator client {
  provider = "prisma-client"
  output   = "../apps/server/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id       String @id
  version  BigInt
  snapshot Json
}

model AlphaMatch {
  id        String   @id
  joinCode  String   @unique
  version   BigInt
  status    String
  snapshot  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
