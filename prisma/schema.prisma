generator client {
  provider = "prisma-client"
  output   = "../apps/server/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id       String @id
  version  BigInt
  snapshot Json
}

model AlphaMatch {
  id        String   @id
  joinCode  String   @unique
  version   BigInt
  status    String
  snapshot  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Original snapshots preserved before an in-place migration rewrites a match. Additive; never updated or deleted by the app.
model AlphaMatchArchive {
  id         String   @id @default(uuid())
  matchId    String
  version    BigInt
  reason     String
  snapshot   Json
  archivedAt DateTime @default(now())

  @@unique([matchId, version])
  @@index([matchId])
}
