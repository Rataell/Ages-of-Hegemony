# Local development (docker compose up db-dev via `npm run db:up`). Throwaway local credentials, not secrets.
DATABASE_URL=postgresql://aoh:aoh@localhost:5432/aoh?schema=public
# Integration tests (`npm run test:db:docker` starts and removes this disposable container itself).
# Must be a LOCAL, dedicated database. Never the public alpha or Supabase database.
ALPHA_TEST_DATABASE_URL=postgresql://aoh:aoh@localhost:5433/aoh_test?schema=public
PORT=4000
# Public alpha: configure private values in the hosting service environment, never in this file.
# DIRECT_URL is optional when DATABASE_URL also supports migration operations.
# DIRECT_URL=postgresql://...
# ALPHA_SESSION_SECRET=generate-a-private-random-secret-of-at-least-32-bytes
# ALPHA_PUBLIC_ORIGIN=https://your-alpha-service.example
# Optional feedback link shown in the alpha (read at build time).
# NEXT_PUBLIC_ALPHA_FEEDBACK_URL=https://your-feedback-form.example

# ---- External alpha (private values live in the hosting service, never here) ----
# One long random string; signs the guest session cookie (this is the SESSION/SIGNING secret). Keep it stable across deploys or every browser loses its seat.
# ALPHA_SESSION_SECRET=
# Exact public HTTPS origin, no trailing slash (invite links and the same-origin check use it).
# ALPHA_PUBLIC_ORIGIN=https://aoh-alpha.example
# Gate for creating/joining a table (not an account system). Unset = open.
# ALPHA_ACCESS_CODE=
# 2..6; defaults to 4 in production and 6 elsewhere.
# ALPHA_MAX_SEATS=4
# Presence/host timing (ms). Defaults: 20000 grace before "Ausente", 60000 before the host role moves, 600000 before a lone player may remove an absent one.
# ALPHA_PRESENCE_GRACE_MS=20000
# ALPHA_HOST_GRACE_MS=60000
# ALPHA_REMOVE_ABSENT_MS=600000
# Set to 0 to silence the JSON operational log.
# ALPHA_LOG=1
